{
    "name": "gainz/fitness-tracker",
    "description": "GAINZ - Fitness tracking web application",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.5",
        "slim/twig-view": "^3.0",
        "psr/log": "^1.1",
        "psr/container": "^1.0 || ^2.0",
        "firebase/php-jwt": "^6.0",
        "dotenv": "^5.4",
        "respect/validation": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Gainz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public",
        "test": "phpunit",
        "lint": "phpcs src/"
    }
}
