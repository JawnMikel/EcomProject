<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GAINZ{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent:     #c8ff00;
            --accent-dim: rgba(200, 255, 0, 0.12);
            --bg:         #080808;
            --panel-bg:   #111111;
            --border:     #272727;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { font-size: 16px; }

        body {
            background: var(--bg);
            color: #fff;
            font-family: 'Barlow Condensed', 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* ── Watermark ── */
        .watermark {
            position: fixed;
            bottom: -10px;
            right: -20px;
            font-size: 260px;
            color: #fff;
            opacity: 0.025;
            pointer-events: none;
            line-height: 1;
            transform: rotate(-8deg);
            z-index: 0;
            font-family: 'bootstrap-icons';
        }

        /* ── Navbar ── */
        .navbar {
            background: #000 !important;
            border-bottom: 1px solid var(--border);
            position: relative;
            z-index: 100;
        }

        .navbar-brand {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: #fff !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .navbar-brand .brand-icon {
            color: var(--accent);
            filter: drop-shadow(0 0 6px rgba(200, 255, 0, 0.6));
        }

        .nav-link {
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 600;
            font-size: 0.78rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #666 !important;
            padding: 0.5rem 1rem !important;
            transition: color 0.2s;
        }

        .nav-link:hover {
            color: var(--accent) !important;
        }

        .nav-link.active {
            color: var(--accent) !important;
        }

        .nav-user {
            font-size: 0.72rem;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #888 !important;
        }

        /* ── Main Content ── */
        .main-wrapper {
            flex: 1;
            padding: 2.5rem 1.5rem;
            position: relative;
            z-index: 1;
        }

        /* ── Section Title ── */
        .section-header {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .section-subtitle {
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #444;
        }

        .section-title-bar {
            width: 40px;
            height: 2px;
            background: var(--accent);
            box-shadow: 0 0 8px rgba(200, 255, 0, 0.5);
            margin-bottom: 1.5rem;
        }

        /* ── Cards ── */
        .panel-card {
            background: var(--panel-bg);
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            padding: 1.5rem;
            box-shadow:
                0 0 0 1px rgba(200, 255, 0, 0.04),
                0 10px 40px rgba(0, 0, 0, 0.5);
            height: 100%;
        }

        .panel-card-title {
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .panel-card-title i {
            color: var(--accent);
        }

        /* ── Dashboard Cards ── */
        .dash-card {
            background: var(--panel-bg);
            border: 1px solid var(--border);
            padding: 1.5rem;
            text-align: center;
            transition: border-color 0.2s, transform 0.2s;
            cursor: default;
        }

        .dash-card:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
        }

        .dash-card-icon {
            font-size: 2rem;
            color: var(--accent);
            margin-bottom: 0.75rem;
            filter: drop-shadow(0 0 8px rgba(200, 255, 0, 0.4));
        }

        .dash-card-title {
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 0.35rem;
        }

        .dash-card-desc {
            font-size: 0.65rem;
            letter-spacing: 1px;
            color: #555;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .dash-card-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            background: transparent;
            border: 1px solid var(--border);
            color: #888;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 0.68rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 0.5rem 1rem;
            text-decoration: none;
            transition: all 0.2s;
        }

        .dash-card-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* ── Form Fields ── */
        .field-label {
            display: block;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .field-wrap {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .auth-input {
            width: 100%;
            background: #0a0a0a;
            border: 1px solid #2a2a2a;
            border-radius: 2px;
            color: #e8e8e8;
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            padding: 0.75rem 1rem;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            -webkit-font-smoothing: antialiased;
        }

        input[type="date"].auth-input {
            color-scheme: dark;
        }

        .auth-input:focus {
            outline: none;
            border-color: var(--accent);
            background: #0c0c0c;
            color: #fff;
            box-shadow:
                0 0 0 3px rgba(200, 255, 0, 0.07),
                inset 0 1px 3px rgba(0, 0, 0, 0.4);
        }

        .auth-input::placeholder {
            color: #303030;
            font-size: 0.78rem;
            letter-spacing: 0.5px;
        }

        /* ── Button ── */
        .btn-gainz {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            background: var(--accent);
            color: #000;
            border: none;
            border-radius: 2px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 0.78rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 0.7rem 1.25rem;
            cursor: pointer;
            box-shadow: 0 0 15px rgba(200, 255, 0, 0.15);
            transition: background 0.15s, box-shadow 0.15s, transform 0.1s;
        }

        .btn-gainz:hover {
            background: #d6ff1f;
            box-shadow: 0 0 25px rgba(200, 255, 0, 0.35);
            transform: translateY(-1px);
            color: #000;
        }

        .btn-gainz:active {
            transform: translateY(0);
        }

        .btn-gainz-outline {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            background: transparent;
            color: #888;
            border: 1px solid var(--border);
            border-radius: 2px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 700;
            font-size: 0.78rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 0.7rem 1.25rem;
            cursor: pointer;
            transition: all 0.15s;
        }

        .btn-gainz-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* ── Tables ── */
        .gainz-table {
            width: 100%;
            border-collapse: collapse;
        }

        .gainz-table th {
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #555;
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        .gainz-table td {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.78rem;
            color: #ccc;
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid #1a1a1a;
        }

        .gainz-table tr:hover td {
            background: rgba(200, 255, 0, 0.03);
        }

        /* ── Stats ── */
        .stat-card {
            background: var(--panel-bg);
            border: 1px solid var(--border);
            padding: 1.25rem;
        }

        .stat-label {
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #555;
            margin-bottom: 0.35rem;
        }

        .stat-value {
            font-size: 1.75rem;
            font-weight: 800;
            color: #fff;
            line-height: 1;
            margin-bottom: 0.25rem;
        }

        .stat-value.accent {
            color: var(--accent);
            text-shadow: 0 0 20px rgba(200, 255, 0, 0.3);
        }

        .stat-desc {
            font-size: 0.6rem;
            letter-spacing: 1px;
            color: #444;
            text-transform: uppercase;
        }

        /* ── List Items ── */
        .gainz-list-item {
            padding: 0.85rem 0;
            border-bottom: 1px solid #1a1a1a;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .gainz-list-item:last-child {
            border-bottom: none;
        }

        .gainz-list-item:hover {
            background: rgba(200, 255, 0, 0.02);
        }

        .gainz-list-title {
            font-size: 0.82rem;
            font-weight: 600;
            color: #e8e8e8;
        }

        .gainz-list-sub {
            font-size: 0.68rem;
            color: #555;
            margin-top: 0.15rem;
        }

        .gainz-list-meta {
            font-size: 0.62rem;
            letter-spacing: 1px;
            color: #444;
            text-transform: uppercase;
        }

        /* ── Alerts ── */
        .alert-gainz {
            background: rgba(200, 255, 0, 0.07);
            border: 1px solid rgba(200, 255, 0, 0.2);
            border-left: 3px solid var(--accent);
            color: #e8e8e8;
            font-size: 0.75rem;
            letter-spacing: 1px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.5rem;
        }

        .alert-gainz-error {
            background: rgba(255, 60, 60, 0.07);
            border: 1px solid rgba(255, 60, 60, 0.2);
            border-left: 3px solid #ff4444;
            color: #ff7070;
        }

        /* ── Footer ── */
        .site-footer {
            background: #000;
            border-top: 1px solid #161616;
            padding: 0.8rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .footer-brand {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--accent);
            text-transform: uppercase;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .footer-links a {
            font-size: 0.62rem;
            letter-spacing: 1px;
            color: #333;
            text-decoration: none;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .footer-links a:hover { color: #666; }

        .footer-copy {
            font-size: 0.62rem;
            letter-spacing: 1px;
            color: #252525;
            text-transform: uppercase;
        }

        /* ── Utility ── */
        .text-accent { color: var(--accent); }
        .text-muted { color: #555 !important; }
        .mb-0 { margin-bottom: 0; }
    </style>
    {% block head %}{% endblock %}
</head>
<body>

{% if session.user_id is defined %}
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/EcomProject/public/dashboard">
            <i class="bi bi-lightning-charge-fill brand-icon"></i> GAINZ
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" style="border-color: var(--border);">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/workouts">Workouts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/programs">Programs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/analytics">Analytics</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/body-weight">Body Weight</a>
                </li>
            </ul>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <span class="nav-link nav-user">{{ session.username }}</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/logout">Logout</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
{% endif %}

<main class="main-wrapper">
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <span class="footer-brand">GAINZ Industrial Athletics. No Weakness.</span>
    <div class="footer-links">
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Support</a>
        <a href="#">API</a>
    </div>
    <span class="footer-copy">&copy; 2025 GAINZ Industrial Athletics.</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>