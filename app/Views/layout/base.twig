<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}GAINZ{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/EcomProject/public/css/gainz-theme.css">
    {% block head %}{% endblock %}
</head>
<body>

{% if session.user_id is defined %}
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/EcomProject/public/dashboard">
            <i class="bi bi-lightning-charge-fill brand-icon"></i> GAINZ
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" style="border-color: var(--border);">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/dashboard">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/workouts">Workouts</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/programs">Programs</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/analytics">Analytics</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/calendar">Calendar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/body-weight">Body Weight</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/exercises">Exercises</a>
                </li>
            </ul>
            <ul class="navbar-nav">
                {% if session.start_time %}
                <li class="nav-item">
                    <a class="nav-link timer-nav-link" href="/EcomProject/public/workouts/active">
                        <i class="bi bi-clock-history"></i>
                        <span id="navTimer">00:00:00</span>
                    </a>
                </li>
                {% endif %}
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/profile"><i class="bi bi-person"></i> {{ session.username }}</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/EcomProject/public/logout">Logout</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
{% if session.start_time %}
<script>
(function() {
    const startTime = new Date('{{ session.start_time }}');
    const timerDisplay = document.getElementById('navTimer');
    if (timerDisplay) {
        setInterval(function() {
            const now = new Date();
            const diff = now - startTime;
            const hours = Math.floor(diff / 3600000);
            const minutes = Math.floor((diff % 3600000) / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);
            timerDisplay.textContent =
                String(hours).padStart(2, '0') + ':' +
                String(minutes).padStart(2, '0') + ':' +
                String(seconds).padStart(2, '0');
        }, 1000);
    }
})();
</script>
<style>
.timer-nav-link {
    background: rgba(200, 255, 0, 0.15);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: 0.35rem 0.75rem !important;
    margin-right: 0.5rem;
}
.timer-nav-link:hover {
    background: rgba(200, 255, 0, 0.25);
}
.timer-nav-link i {
    margin-right: 0.35rem;
    color: var(--accent);
}
#navTimer {
    font-family: 'Share Tech Mono', monospace;
    color: var(--accent);
    font-weight: 600;
}
</style>
{% endif %}
{% endif %}

<main class="main-wrapper">
    {% block content %}{% endblock %}
</main>

<footer class="site-footer">
    <span class="footer-brand">GAINZ Industrial Athletics. No Weakness.</span>
    <div class="footer-links">
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Support</a>
        <a href="#">API</a>
    </div>
    <span class="footer-copy">&copy; 2025 GAINZ Industrial Athletics.</span>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>