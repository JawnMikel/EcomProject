{% extends "layout/base.twig" %}

{% block title %}Calendar — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-calendar3"></i></div>

{% set monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'] %}
{% set dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] %}

<div class="calendar-page-wrapper">
    <div class="calendar-container">
        <!-- Left Column: Calendar -->
        <div>
            <!-- Calendar Navigation -->
            <div class="calendar-nav">
                <a href="/EcomProject/public/calendar?year={{ month > 1 ? year : year - 1 }}&month={{ month > 1 ? month - 1 : 12 }}" class="nav-arrow">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <h2 class="calendar-month">{{ monthNames[month - 1] }} {{ year }}</h2>
                <a href="/EcomProject/public/calendar?year={{ month < 12 ? year : year + 1 }}&month={{ month < 12 ? month + 1 : 1 }}" class="nav-arrow">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </div>

            <!-- Calendar Grid -->
            <div class="calendar-grid">
                {% for day in dayNames %}
                <div class="calendar-header-cell">{{ day }}</div>
                {% endfor %}

                {% set firstDayOfMonth = year ~ '-' ~ (month < 10 ? '0' ~ month : month) ~ '-01' %}
                {% set startPadding = firstDayOfMonth|date('w') %}
                {% set daysInMonth = (year ~ '-' ~ (month < 10 ? '0' ~ month : month) ~ '-01')|date('t') %}

                {# Empty cells before first day #}
                {% for i in 0..(startPadding - 1) %}
                <div class="calendar-cell empty"></div>
                {% endfor %}

                {# Day cells #}
                {% set workoutDates = {} %}
                {% for w in workouts %}
                    {% set workoutDates = workoutDates|merge({(w.start_time|date('Y-m-d')): w}) %}
                {% endfor %}

                {% for day in 1..daysInMonth %}
                    {% set currentDate = year ~ '-' ~ (month < 10 ? '0' ~ month : month) ~ '-' ~ (day < 10 ? '0' ~ day : day) %}
                    {% set hasWorkout = workoutDates[currentDate] is defined %}
                    <div class="calendar-cell {% if hasWorkout %}has-workout{% endif %}">
                        <span class="day-number">{{ day }}</span>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Right Column: Workout List -->
        {% if workouts %}
        <div class="workout-list-panel">
            <h5 class="panel-card-title">
                <i class="bi bi-list-check"></i> Workouts
            </h5>
            <div class="workout-list">
                {% for session in workouts %}
                <div class="workout-list-item">
                    <div class="workout-date-block">
                        <span class="month-day">{{ session.start_time|date('j') }}</span>
                        <span class="month-name">{{ session.start_time|date('M') }}</span>
                    </div>
                    <div class="workout-info">
                        <div class="workout-time-label">{{ session.start_time|date('l') }} at {{ session.start_time|date('g:i a') }}</div>
                        <div class="workout-stats">
                            <span>{{ (session.total_duration / 60)|round(0) }} min</span>
                            <span>{{ session.total_volume ? session.total_volume ~ ' lbs' : '—' }}</span>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>

    {% if not workouts %}
    <p class="empty-state">No workouts this month. Time to train!</p>
    {% endif %}
</div>

<style>
/* Center everything - fit in portrait 1080x1920 */
.calendar-page-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 1rem 0;
    max-height: 100vh;
    overflow: hidden;
}

/* Header */
.section-header {
    margin-bottom: 1.5rem;
    text-align: center;
}

.section-title {
    font-size: 2.5rem;
    margin-bottom: 0.35rem;
}

.section-subtitle {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

.section-title-bar {
    width: 120px;
    height: 4px;
    margin: 0 auto;
}

/* Single column layout - stacked, centered */
.calendar-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    width: 100%;
    max-width: 1100px;
}

.calendar-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
}

.calendar-month {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    min-width: 280px;
    text-align: center;
}

.nav-arrow {
    color: var(--text-muted);
    font-size: 2.5rem;
    transition: color 0.2s, transform 0.2s;
    padding: 0.3rem;
    text-decoration: none;
}

.nav-arrow:hover {
    color: var(--accent);
    transform: scale(1.1);
}

.calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    background: var(--panel-bg);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: 10px;
    width: 100%;
    max-width: 1050px;
}

.calendar-header-cell {
    text-align: center;
    padding: 0.75rem;
    font-weight: 600;
    font-size: 1.2rem;
    color: #555;
    text-transform: uppercase;
}

.calendar-cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0d0d0d;
    border: 1px solid var(--border);
    transition: all 0.2s;
}

.calendar-cell.empty {
    background: transparent;
    border: none;
}

.calendar-cell:not(.empty):hover {
    border-color: var(--accent);
}

.calendar-cell.has-workout {
    background: linear-gradient(135deg, rgba(200, 255, 0, 0.15), rgba(200, 255, 0, 0.05));
    border-color: var(--accent);
}

.day-number {
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--text);
}

.calendar-cell.has-workout .day-number {
    color: var(--accent);
}

/* Workout list */
.workout-list-panel {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    width: 100%;
    max-width: 1050px;
    max-height: 380px;
    overflow-y: auto;
}

.panel-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 0.4rem;
}

.panel-card-title i {
    color: var(--accent);
}

.workout-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.workout-list-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem;
    background: #0d0d0d;
    border: 1px solid var(--border);
    border-radius: 4px;
}

.workout-date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 40px;
    padding-right: 0.5rem;
    border-right: 1px solid var(--border);
}

.month-day {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
}

.month-name {
    font-size: 0.85rem;
    color: #555;
    text-transform: uppercase;
}

.workout-info {
    flex: 1;
    min-width: 0;
}

.workout-time-label {
    font-size: 1.1rem;
    color: var(--text);
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.workout-stats {
    display: flex;
    gap: 1.25rem;
}

.workout-stats span {
    font-size: 0.95rem;
    color: #555;
}

.empty-state {
    text-align: center;
    color: #444;
    padding: 0.5rem;
    font-size: 0.75rem;
}
</style>
{% endblock %}