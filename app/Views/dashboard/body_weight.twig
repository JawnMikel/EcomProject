{% extends "layout/base.twig" %}

{% block title %}Body Weight — GAINZ{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold">Body Weight</h1>
        <p class="text-muted">Track your weight progress over time.</p>
    </div>
</div>

{% if success %}
<div class="alert alert-success">{{ success }}</div>
{% endif %}
{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">New Entry</h5>
                <form action="/EcomProject/public/body-weight" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Date</label>
                        <input type="date" class="form-control" name="entry_date" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Weight (kg)</label>
                        <input type="number" step="0.1" class="form-control" name="weight_value" required>
                    </div>
                    <button class="btn btn-dark">Save Entry</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Recent Entries</h5>
                {% if entries %}
                <table class="table table-borderless mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Weight</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in entries %}
                        <tr>
                            <td>{{ entry.entry_date }}</td>
                            <td>{{ entry.weight_value }} kg</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% else %}
                <p class="text-muted">No weight entries found yet.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
