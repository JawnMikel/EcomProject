{% extends "layout/base.twig" %}

{% block title %}Body Weight — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title" data-i18n="body_weight.title">Body Weight</h1>
    <p class="section-subtitle" data-i18n="body_weight.subtitle">Track your weight progress over time.</p>
    <div class="section-title-bar"></div>
</div>

{% if success %}
<div class="alert-gainz">
    <i class="bi bi-check-circle me-1"></i>{{ success }}
</div>
{% endif %}
{% if error %}
<div class="alert-gainz alert-gainz-error">
    <i class="bi bi-exclamation-triangle me-1"></i>{{ error }}
</div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel-card mb-4">
            <h5 class="panel-card-title">
                <i class="bi bi-plus-circle" data-i18n="body_weight.new_entry">New Entry</i> New Entry
            </h5>
            <form action="/EcomProject/public/body-weight" method="POST">
                <div>
                    <label class="field-label" for="weight_value" data-i18n="body_weight.weight_lbs">Weight (lbs)</label>
                    <div class="field-wrap">
                        <input type="number" id="weight_value" name="weight_value" class="auth-input" step="0.1" data-i18n="body_weight.weight_placeholder" placeholder="Weight in lbs" required>
                    </div>
                </div>
                <button type="submit" class="btn-gainz" data-i18n="body_weight.save_entry">Save Entry</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel-card">
            <h5 class="panel-card-title">
                <i class="bi bi-clock-history" data-i18n="body_weight.recent_entries">Recent Entries</i> Recent Entries
            </h5>
            {% if entries %}
            <table class="gainz-table">
                <thead>
                    <tr>
                        <th data-i18n="common.date">Date</th>
                        <th data-i18n="common.weight">Weight</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                    <tr>
                        <td>{{ entry.entry_date }}</td>
                        <td>{{ entry.weight_value }} <span data-i18n="common.lbs">lbs</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="text-muted mb-0" data-i18n="body_weight.no_entries">No weight entries found yet.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}