{% extends "layout/base.twig" %}

{% block title %}Training Programs — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title">Training Programs</h1>
    <p class="section-subtitle">Create and manage your training templates.</p>
    <div class="section-title-bar"></div>
</div>

{% if success %}
<div class="alert-gainz">
    <i class="bi bi-check-circle me-1"></i>{{ success }}
</div>
{% endif %}
{% if error %}
<div class="alert-gainz alert-gainz-error">
    <i class="bi bi-exclamation-triangle me-1"></i>{{ error }}
</div>
{% endif %}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel-card mb-4">
            <h5 class="panel-card-title">
                <i class="bi bi-plus-circle"></i> New Program
            </h5>
            <form action="/EcomProject/public/programs" method="POST">
                <div>
                    <label class="field-label" for="name">Program Name</label>
                    <div class="field-wrap">
                        <input type="text" id="name" name="name" class="auth-input" placeholder="Program name" required>
                    </div>
                </div>
                <div>
                    <label class="field-label" for="description">Description</label>
                    <div class="field-wrap">
                        <textarea id="description" name="description" class="auth-input" rows="4" placeholder="Add goals or focus areas"></textarea>
                    </div>
                </div>
                <button type="submit" class="btn-gainz">Save Program</button>
            </form>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel-card">
            <h5 class="panel-card-title">
                <i class="bi bi-collection"></i> My Programs
            </h5>
            {% if programs %}
            <div>
                {% for program in programs %}
                <div class="gainz-list-item">
                    <div>
                        <div class="gainz-list-title">{{ program.name }}</div>
                        <div class="gainz-list-sub">{{ program.description ?: 'No description provided.' }}</div>
                    </div>
                    <div class="gainz-list-meta">Program #{{ program.id }}</div>
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-muted mb-0">You haven't created any programs yet.</p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}