{% extends "layout/base.twig" %}

{% block title %}Training Programs — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title">Training Programs</h1>
    <p class="section-subtitle">Build your workout routines.</p>
    <div class="section-title-bar"></div>
    <a href="/EcomProject/public/programs/explore" class="btn-gainz explore-btn">
        <i class="bi bi-compass"></i> Explore
    </a>
</div>

{% if success %}
<div class="alert-gainz">
    <i class="bi bi-check-circle me-1"></i>{{ success }}
</div>
{% endif %}
{% if error %}
<div class="alert-gainz alert-gainz-error">
    <i class="bi bi-exclamation-triangle me-1"></i>{{ error }}
</div>
{% endif %}

<div class="programs-layout">
    <!-- Create New Program -->
    <div class="panel-card program-create">
        <h5 class="panel-card-title">
            <i class="bi bi-plus-circle"></i> New Routine
        </h5>
        <form action="/EcomProject/public/programs" method="POST">
            <label class="field-label" for="name">Routine Name</label>
            <input type="text" id="name" name="name" class="auth-input mb-3" placeholder="e.g., Push Day, Leg Day" required>
            <button type="submit" class="btn-gainz w-100">
                <i class="bi bi-plus-lg"></i> Create
            </button>
        </form>
    </div>

    <!-- Programs List -->
    <div class="panel-card program-list">
        <h5 class="panel-card-title">
            <i class="bi bi-collection"></i> My Routines
        </h5>
        {% if programs %}
        <div class="routine-cards">
            {% for program in programs %}
            <div class="routine-card">
                <div class="routine-header">
                    <h6 class="routine-name">{{ program.name }}</h6>
                    <div class="routine-actions">
                        <span class="routine-count">{{ program.workouts|length }} exercises</span>
                        <form method="POST" action="/EcomProject/public/programs/delete" class="routine-delete-form">
                            <input type="hidden" name="program_id" value="{{ program.id }}">
                            <button type="submit" class="btn-icon btn-delete" title="Delete routine">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Add Exercise Form -->
                <form method="POST" action="/EcomProject/public/programs/add-exercise" class="routine-add-form">
                    <input type="hidden" name="program_id" value="{{ program.id }}">
                    <div class="exercise-autocomplete">
                        <input type="text" name="exercise_name" class="auth-input exercise-input" placeholder="Exercise name..." required autocomplete="off">
                        <div class="autocomplete-dropdown"></div>
                    </div>
                    <input type="number" name="target_sets" class="auth-input sets-input" placeholder="Sets" min="1" max="20">
                    <input type="number" name="target_reps" class="auth-input reps-input" placeholder="Reps" min="1" max="100">
                    <button type="submit" class="btn-gainz-outline">
                        <i class="bi bi-plus"></i>
                    </button>
                </form>

                <!-- Exercise List -->
                {% if program.workouts %}
                <div class="exercise-list">
                    {% for workout in program.workouts %}
                    <div class="exercise-item">
                        <div class="exercise-info">
                            <span class="exercise-name">{{ workout.exercise_name }}</span>
                            <span class="exercise-category">{{ workout.category_name }}</span>
                        </div>
                        <form method="POST" action="/EcomProject/public/programs/update-exercise" class="exercise-sets-form">
                            <input type="hidden" name="pwe_id" value="{{ workout.pwe_id }}">
                            <input type="number" name="target_sets" class="auth-input sets-input" value="{{ workout.target_sets }}" placeholder="Sets" min="1" max="20">
                            <input type="number" name="target_reps" class="auth-input reps-input" value="{{ workout.target_reps }}" placeholder="Reps" min="1" max="100">
                            <button type="submit" class="btn-icon" title="Update">
                                <i class="bi bi-check2"></i>
                            </button>
                        </form>
                        <form method="POST" action="/EcomProject/public/programs/delete-exercise">
                            <input type="hidden" name="pwe_id" value="{{ workout.pwe_id }}">
                            <button type="submit" class="btn-icon btn-delete" title="Remove">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% else %}
        <p class="empty-state">No routines yet. Create your first one!</p>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Autocomplete for exercise input
    const exerciseInputs = document.querySelectorAll('.exercise-autocomplete input');

    exerciseInputs.forEach(input => {
        const container = input.closest('.exercise-autocomplete');
        const dropdown = container.querySelector('.autocomplete-dropdown');
        let debounceTimer;
        let selectedIndex = -1;
        let items = [];

        input.addEventListener('input', function() {
            clearTimeout(debounceTimer);
            const query = this.value.trim();
            selectedIndex = -1;

            debounceTimer = setTimeout(() => {
                fetch('/EcomProject/public/exercises/search?q=' + encodeURIComponent(query))
                    .then(res => res.json())
                    .then(data => {
                        items = data;
                        if (data.length > 0) {
                            dropdown.innerHTML = data.map((ex, i) =>
                                '<div class="autocomplete-item' + (i === selectedIndex ? ' selected' : '') + '" data-name="' + ex.name + '">' + ex.name + '</div>'
                            ).join('');
                            dropdown.classList.add('show');
                        } else {
                            dropdown.classList.remove('show');
                        }
                    });
            }, 200);
        });

        // Show all exercises on focus
        input.addEventListener('focus', function() {
            selectedIndex = -1;
            fetch('/EcomProject/public/exercises/search?q=')
                .then(res => res.json())
                .then(data => {
                    items = data;
                    if (data.length > 0) {
                        dropdown.innerHTML = data.map((ex, i) =>
                            '<div class="autocomplete-item' + (i === selectedIndex ? ' selected' : '') + '" data-name="' + ex.name + '">' + ex.name + '</div>'
                        ).join('');
                        dropdown.classList.add('show');
                    }
                });
        });

        input.addEventListener('keydown', function(e) {
            if (!dropdown.classList.contains('show') || items.length === 0) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                updateSelection();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                selectedIndex = Math.max(selectedIndex - 1, -1);
                updateSelection();
            } else if (e.key === 'Enter') {
                e.preventDefault();
                if (selectedIndex >= 0) {
                    input.value = items[selectedIndex].name;
                    dropdown.classList.remove('show');
                }
            } else if (e.key === 'Escape') {
                dropdown.classList.remove('show');
            }
        });

        function updateSelection() {
            const allItems = dropdown.querySelectorAll('.autocomplete-item');
            allItems.forEach((item, i) => {
                item.classList.toggle('selected', i === selectedIndex);
            });
        }

        input.addEventListener('blur', function() {
            setTimeout(() => dropdown.classList.remove('show'), 150);
        });

        dropdown.addEventListener('click', function(e) {
            if (e.target.classList.contains('autocomplete-item')) {
                input.value = e.target.dataset.name;
                dropdown.classList.remove('show');
            }
        });
    });
});
</script>

<style>
.section-header {
    position: relative;
}

.explore-btn {
    position: absolute;
    right: 0;
    top: 0;
}

.programs-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 1.5rem;
    align-items: start;
}

@media (max-width: 992px) {
    .programs-layout {
        grid-template-columns: 1fr;
    }
}

.program-create {
    background: linear-gradient(145deg, #151515 0%, #0f0f0f 100%);
}

.routine-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.routine-card {
    background: #0a0a0a;
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-left: 2px solid var(--accent);
}

.routine-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}

.routine-name {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
}

.routine-count {
    font-size: 0.65rem;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.routine-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.routine-delete-form {
    margin: 0;
}

.routine-delete-form .btn-icon {
    font-size: 0.85rem;
    padding: 0.25rem;
}

.routine-add-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.routine-add-form .auth-input {
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
}

.routine-add-form .exercise-input {
    flex: 2;
}

.exercise-autocomplete {
    position: relative;
    flex: 2;
}

.autocomplete-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #111;
    border: 1px solid var(--border);
    border-top: none;
    max-height: 200px;
    overflow-y: auto;
    z-index: 100;
    display: none;
}

.autocomplete-dropdown.show {
    display: block;
}

.autocomplete-item {
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    font-size: 0.8rem;
    color: #ccc;
    transition: background 0.15s;
}

.autocomplete-item:hover,
.autocomplete-item.selected {
    background: rgba(200, 255, 0, 0.1);
    color: var(--accent);
}

.routine-add-form .sets-input,
.routine-add-form .reps-input {
    flex: 1;
    min-width: 60px;
}

.routine-add-form .btn-gainz-outline {
    padding: 0.5rem 0.75rem;
}

.exercise-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
}

.exercise-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: #111;
    border-radius: 2px;
}

.exercise-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.exercise-name {
    font-size: 0.82rem;
    color: #ccc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.exercise-category {
    font-size: 0.6rem;
    color: #444;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.exercise-sets-form {
    display: flex;
    gap: 0.35rem;
}

.exercise-sets-form .sets-input,
.exercise-sets-form .reps-input {
    width: 55px;
    padding: 0.35rem 0.5rem;
    font-size: 0.7rem;
    text-align: center;
}

.btn-icon {
    background: transparent;
    border: none;
    color: #555;
    cursor: pointer;
    padding: 0.35rem 0.5rem;
    font-size: 0.9rem;
    transition: color 0.15s;
}

.btn-icon:hover {
    color: var(--accent);
}

.btn-icon.btn-delete:hover {
    color: #ff4444;
}

.empty-state {
    padding: 2.5rem 0;
    text-align: center;
    color: #444;
}
</style>
{% endblock %}