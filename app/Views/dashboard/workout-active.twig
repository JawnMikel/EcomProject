<script>
let restInterval = null;
let restSeconds = 60;

// Store rest times per exercise
const exerciseRestTimes = {};

// Load saved rest times from localStorage
const savedTimes = localStorage.getItem('exerciseRestTimes');
if (savedTimes) {
    Object.assign(exerciseRestTimes, JSON.parse(savedTimes));
}

function saveRestTime(exerciseId, seconds) {
    exerciseRestTimes[exerciseId] = parseInt(seconds);
    localStorage.setItem('exerciseRestTimes', JSON.stringify(exerciseRestTimes));
}

function updateSet(setId, field, value) {
    fetch('/EcomProject/public/workouts/update-set', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: 'set_id=' + setId + '&field=' + field + '&value=' + value
    });
}

function markSetDone(setId, exerciseId) {
    const btn = event.currentTarget;
    const row = btn.closest('.set-row');
    const icon = btn.querySelector('i');

    if (row.classList.contains('set-completed')) {
        row.classList.remove('set-completed');
        icon.className = 'bi bi-circle';
        btn.classList.remove('done');
    } else {
        row.classList.add('set-completed');
        icon.className = 'bi bi-check-circle-fill';
        btn.classList.add('done');

        // Use saved rest time for this exercise (default 60s)
        const restTime = exerciseRestTimes[exerciseId] || 60;
        startRestTimer(restTime);
    }
}

function startRestTimer(seconds) {
    stopRestTimer();
    restSeconds = seconds;

    const restBlock = document.getElementById('restBlock');
    const countdown = document.getElementById('restCountdown');

    restBlock.style.display = 'flex';

    restInterval = setInterval(function() {
        restSeconds--;
        const mins = Math.floor(restSeconds / 60);
        const secs = restSeconds % 60;
        countdown.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');

        if (restSeconds <= 0) {
            stopRestTimer();
            playBeep();
            alert('Rest time is up! Ready for your next set.');
        }
    }, 1000);
}

function stopRestTimer() {
    if (restInterval) {
        clearInterval(restInterval);
        restInterval = null;
    }
    document.getElementById('restBlock').style.display = 'none';
}

function playBeep() {
    try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        oscillator.frequency.value = 880;
        gainNode.gain.value = 0.3;
        oscillator.start();
        oscillator.stop(audioCtx.currentTime + 0.2);
    } catch (e) {}
}

let timerRunning = false;
let timerInterval = null;
let customTimerRunning = false;
let customTimerInterval = null;

function toggleTimer() {
    const btn = document.getElementById('timerToggleBtn');
    const icon = document.getElementById('timerIcon');
    const timerDisplay = document.getElementById('mainTimer');

    if (timerRunning) {
        // Stop the elapsed timer
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
        timerRunning = false;
        icon.className = 'bi bi-play-fill';
        btn.style.background = 'var(--accent)';
    } else {
        // Start the elapsed timer
        timerRunning = true;
        icon.className = 'bi bi-pause-fill';
        btn.style.background = '#22c55e';

        const startTime = new Date('{{ session.start_time }}');
        timerInterval = setInterval(function() {
            const now = new Date();
            const diff = now - startTime;
            const hours = Math.floor(diff / 3600000);
            const minutes = Math.floor((diff % 3600000) / 60000);
            const seconds = Math.floor((diff % 60000) / 1000);
            timerDisplay.textContent =
                String(hours).padStart(2, '0') + ':' +
                String(minutes).padStart(2, '0') + ':' +
                String(seconds).padStart(2, '0');
        }, 1000);
    }
}

function startCustomTimer() {
    const minInput = document.getElementById('customMin');
    const secInput = document.getElementById('customSec');
    const minutes = parseInt(minInput.value) || 0;
    const seconds = parseInt(secInput.value) || 0;
    const totalSeconds = (minutes * 60) + seconds;

    if (totalSeconds <= 0) {
        alert('Please enter a time greater than 0');
        return;
    }

    // Stop any running timer first
    if (timerRunning) {
        toggleTimer();
    }

    // Stop rest timer if running
    stopRestTimer();

    let remaining = totalSeconds;
    const restBlock = document.getElementById('restBlock');
    const countdown = document.getElementById('restCountdown');

    restBlock.style.display = 'flex';

    customTimerRunning = true;
    customTimerInterval = setInterval(function() {
        remaining--;
        const mins = Math.floor(remaining / 60);
        const secs = remaining % 60;
        countdown.textContent = String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');

        if (remaining <= 0) {
            stopCustomTimer();
            // Play a beep sound
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.frequency.value = 880;
                gainNode.gain.value = 0.3;
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.2);
            } catch (e) {}
            alert('Timer complete!');
        }
    }, 1000);
}

function stopCustomTimer() {
    if (customTimerInterval) {
        clearInterval(customTimerInterval);
        customTimerInterval = null;
    }
    customTimerRunning = false;
    document.getElementById('restBlock').style.display = 'none';
}

document.addEventListener('DOMContentLoaded', function() {
    const startTime = new Date('{{ session.start_time }}');
    const timerDisplay = document.getElementById('mainTimer');

    function updateTimer() {
        const now = new Date();
        const diff = now - startTime;
        const hours = Math.floor(diff / 3600000);
        const minutes = Math.floor((diff % 3600000) / 60000);
        const seconds = Math.floor((diff % 60000) / 1000);
        timerDisplay.textContent =
            String(hours).padStart(2, '0') + ':' +
            String(minutes).padStart(2, '0') + ':' +
            String(seconds).padStart(2, '0');
    }

    updateTimer();
    setInterval(updateTimer, 1000);
});
</script>
</div>
{% endblock %}