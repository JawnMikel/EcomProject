{% extends "layout/base.twig" %}

{% block title %}Active Workout — GAINZ{% endblock %}

{% block content %}
<div class="compact-page">
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title">Active Workout</h1>
    <p class="section-subtitle">Add exercises and track your sets</p>
    <div class="section-title-bar"></div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="panel-card mb-3">
            <h5 class="panel-card-title">
                <i class="bi bi-dumbbell"></i> Exercises
            </h5>

            {% if exercises is empty %}
            <div class="text-center py-4">
                <p class="text-muted mb-3">No exercises added yet. Click the button below to add exercises.</p>
            </div>
            {% else %}
            <div class="exercise-list">
                {% for exerciseId, data in exercise_details %}
                <div class="exercise-item mb-3">
                    <div class="exercise-header">
                        <div class="exercise-title-row">
                            <h6 class="exercise-name">{{ data.info.name }}</h6>
                            <span class="badge-difficulty badge-{{ data.info.difficulty }}">{{ data.info.difficulty }}</span>
                        </div>
                        <div class="rest-setting">
                            <label>Rest:</label>
                            <select class="rest-select" onchange="saveRestTime({{ exerciseId }}, this.value)">
                                <option value="30" {% if data.info.rest_time|default(60) == 30 %}selected{% endif %}>30s</option>
                                <option value="60" {% if data.info.rest_time|default(60) == 60 %}selected{% endif %}>60s</option>
                                <option value="90" {% if data.info.rest_time|default(60) == 90 %}selected{% endif %}>90s</option>
                                <option value="120" {% if data.info.rest_time|default(60) == 120 %}selected{% endif %}>2m</option>
                                <option value="180" {% if data.info.rest_time|default(60) == 180 %}selected{% endif %}>3m</option>
                            </select>
                        </div>
                    </div>

                    <div class="sets-list">
                        <!-- Column Headers -->
                        <div class="sets-header-row">
                            <div class="col-set">SET</div>
                            <div class="col-weight"><i class="bi bi-dumbbell"></i> LBS</div>
                            <div class="col-reps">REPS</div>
                            <div class="col-actions"><i class="bi bi-check-lg"></i></div>
                        </div>

                        {% for set in data.sets %}
                        <div class="set-row {% if set.completed|default(false) %}set-completed{% endif %}">
                            <div class="col-set set-number">{{ set.set_number }}</div>
                            <div class="col-weight">
                                <input type="number" class="set-input" value="{{ set.weight }}" step="0.5" min="0" onchange="updateSet({{ set.id }}, 'weight', this.value)">
                            </div>
                            <div class="col-reps">
                                <input type="number" class="set-input" value="{{ set.reps }}" min="0" onchange="updateSet({{ set.id }}, 'reps', this.value)">
                            </div>
                            <div class="col-actions">
                                <button type="button" class="btn-done {% if set.completed|default(false) %}done{% endif %}" onclick="markSetDone({{ set.id }}, {{ exerciseId }})">
                                    <i class="bi {% if set.completed|default(false) %}bi-check-square-fill{% else %}bi-square{% endif %}"></i>
                                </button>
                                <form method="POST" action="/EcomProject/public/workouts/delete-set" style="display:inline;">
                                    <input type="hidden" name="set_id" value="{{ set.id }}">
                                    <button type="submit" class="btn-delete-set" title="Delete set">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                        {% endfor %}

                        <!-- Add Set Button -->
                        <form method="POST" action="/EcomProject/public/workouts/add-set" class="add-set-btn-row">
                            <input type="hidden" name="exercise_id" value="{{ exerciseId }}">
                            <input type="number" name="reps" class="add-set-input" placeholder="Reps" min="1" required>
                            <input type="number" name="weight" class="add-set-input" placeholder="lbs" step="0.5" min="0">
                            <button type="submit" class="btn-add-set-simple">
                                <i class="bi bi-plus-lg"></i> Add Set
                            </button>
                        </form>
                    </div>
                </div>
                {% endfor %}
            </div>
            {% endif %}

            <button class="btn-gainz mt-2" onclick="toggleExercisePanel()">
                <i class="bi bi-plus-circle"></i> Add Exercise
            </button>
        </div>
    </div>

    <!-- Exercise Picker Panel -->
    <div id="exercisePickerOverlay" class="exercise-picker-panel overlay" style="display: none;" onclick="toggleExercisePanel()"></div>
    <div id="exercisePickerPanel" class="exercise-picker-panel" style="display: none;">
        <div class="panel-header">
            <h5>Select Exercise</h5>
            <button type="button" onclick="toggleExercisePanel()" class="btn-close btn-close-white"></button>
        </div>
        <div class="panel-body">
            {% if all_exercises %}
            <input type="text" id="exerciseSearch" class="auth-input w-100 mb-3" placeholder="Search exercises...">
            <div class="exercise-grid" id="exerciseGrid">
                {% for exercise in all_exercises %}
                <button type="button" class="exercise-select-btn" onclick="addExercise({{ exercise.id }})">
                    <span class="exercise-select-name">{{ exercise.name }}</span>
                    <span class="exercise-select-category">{{ exercise.category_name }}</span>
                </button>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-muted">No exercises available.</p>
            {% endif %}
        </div>
    </div>

    <div class="col-lg-4">
        <div class="sidebar-stack">
            <div class="timer-bar">
                <div class="timer-block">
                    <button type="button" class="timer-control-btn" id="timerToggleBtn" onclick="toggleTimer()">
                        <i class="bi bi-play-fill" id="timerIcon"></i>
                    </button>
                    <span class="timer-display" id="mainTimer">00:00</span>
                </div>
                <div class="rest-block" id="restBlock" style="display: none;">
                    <span class="rest-label">REST</span>
                    <span class="rest-countdown" id="restCountdown">00:00</span>
                </div>
            </div>

            <div class="custom-timer-bar">
                <span class="timer-label">Custom Timer:</span>
                <div class="custom-timer-inputs">
                    <input type="number" id="customMin" class="timer-input" placeholder="0" min="0" max="99" value="0">
                    <span class="timer-sep">:</span>
                    <input type="number" id="customSec" class="timer-input" placeholder="30" min="0" max="59" value="30">
                </div>
                <button type="button" class="timer-start-btn" onclick="startCustomTimer()">
                    <i class="bi bi-play-fill"></i>
                </button>
            </div>

            <div class="rest-controls-bar">
                <span class="rest-label">Quick Rest:</span>
                <button type="button" class="rest-btn-chip" onclick="startRestTimer(30)">30s</button>
                <button type="button" class="rest-btn-chip" onclick="startRestTimer(60)">60s</button>
                <button type="button" class="rest-btn-chip" onclick="startRestTimer(90)">90s</button>
                <button type="button" class="rest-btn-chip" onclick="startRestTimer(120)">2m</button>
            </div>

            <form method="POST" action="/EcomProject/public/workouts/complete" class="finish-bar" onsubmit="localStorage.removeItem('exerciseRestTimes');">
                <button type="submit" class="btn-finish">
                    <i class="bi bi-check-lg"></i> Finish Workout
                </button>
            </form>
            <a href="/EcomProject/public/workouts" class="cancel-link">Cancel</a>
        </div>
    </div>
</div>

<form id="addExerciseForm" method="POST" action="/EcomProject/public/workouts/add-exercise" style="display: none;">
    <input type="hidden" name="exercise_id" id="selectedExerciseId">
</form>

<script>
function addExercise(exerciseId) {
    document.getElementById('selectedExerciseId').value = exerciseId;
    document.getElementById('addExerciseForm').submit();
}

function toggleExercisePanel() {
    const panel = document.getElementById('exercisePickerPanel');
    const overlay = document.getElementById('exercisePickerOverlay');
    if (panel.style.display === 'none' || panel.style.display === '') {
        panel.style.display = 'flex';
        overlay.style.display = 'block';
    } else {
        panel.style.display = 'none';
        overlay.style.display = 'none';
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // Initialize rest select values from localStorage
    document.querySelectorAll('.rest-select').forEach(function(select) {
        const exerciseId = select.getAttribute('onchange').match(/\d+/)[0];
        if (exerciseRestTimes[exerciseId]) {
            select.value = exerciseRestTimes[exerciseId];
        }
    });

    const searchInput = document.getElementById('exerciseSearch');
    const exerciseGrid = document.getElementById('exerciseGrid');
    const exerciseButtons = exerciseGrid ? exerciseGrid.querySelectorAll('.exercise-select-btn') : [];

    if (searchInput && exerciseGrid) {
        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            exerciseButtons.forEach(function(btn) {
                const name = btn.querySelector('.exercise-select-name').textContent.toLowerCase();
                const category = btn.querySelector('.exercise-select-category').textContent.toLowerCase();
                if (name.includes(searchTerm) || category.includes(searchTerm)) {
                    btn.style.display = 'flex';
                } else {
                    btn.style.display = 'none';
                }
            });
        });
    }
});
</script>

