{% extends "layout/base.twig" %}

{% block title %}Dashboard — GAINZ{% endblock %}

{% block head %}
<style>
.dash-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
}
@media (max-width: 992px) {
    .dash-grid { grid-template-columns: 1fr; }
}
.dash-header {
    margin-bottom: 2rem;
}
.dash-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
}
.dash-header p {
    color: #777;
    font-size: 0.95rem;
}
.stat-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 768px) {
    .stat-cards { grid-template-columns: repeat(2, 1fr); }
}
.stat-card {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: 0.5rem;
}
.stat-card-label {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
}
.stat-card-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
}
.stat-card-value small {
    font-size: 0.8rem;
    font-weight: 400;
    color: #666;
}
.stat-card-hint {
    font-size: 0.75rem;
    color: #555;
    margin-top: 0.5rem;
}
.panel-box {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
}
.panel-box h3 {
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1a1a1a;
}
.panel-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 576px) {
    .panel-row { grid-template-columns: 1fr; }
}
.stat-inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid #161616;
}
.stat-inline:last-child { border-bottom: none; }
.stat-inline-label {
    font-size: 0.72rem;
    letter-spacing: 1px;
    color: #666;
    text-transform: uppercase;
}
.stat-inline-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
}
.stat-inline-value.active { color: var(--accent); }
.article-list { display: flex; flex-direction: column; gap: 0.75rem; }
.article-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(255,255,255,0.02);
    border-radius: 0.35rem;
    border: 1px solid #161616;
}
.article-item-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddd;
    margin-bottom: 0.25rem;
}
.article-item-desc {
    font-size: 0.72rem;
    color: #666;
}
.badge-read {
    font-size: 0.6rem;
    background: rgba(200,255,0,0.1);
    color: var(--accent);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
}
.action-item {
    padding: 1rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid #161616;
    border-radius: 0.45rem;
    margin-bottom: 0.75rem;
}
.action-item:last-child { margin-bottom: 0; }
.action-label {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
}
.action-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
}
.action-note {
    font-size: 0.72rem;
    color: #666;
    margin-top: 0.35rem;
}
.supplement-grid {
    display: grid;
    gap: 0.75rem;
}
.supplement-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: rgba(255,255,255,0.02);
    border-radius: 0.35rem;
}
.supplement-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddd;
}
.supplement-benefit {
    font-size: 0.7rem;
    color: #666;
    margin-top: 0.15rem;
}
.supplement-tag {
    font-size: 0.55rem;
    background: rgba(200,255,0,0.1);
    color: var(--accent);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
}
.workout-history {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}
.workout-card {
    background: #0a0a0a;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding: 1rem;
    border-radius: 4px;
}
.workout-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
}
.workout-date {
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
}
.workout-time {
    font-size: 0.7rem;
    color: #666;
    margin-left: 0.5rem;
}
.workout-header > div {
    display: flex;
    align-items: baseline;
}
.workout-duration {
    font-size: 0.75rem;
    color: var(--accent);
    background: rgba(207,255,0,0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
}
.workout-exercises {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}
.workout-exercise {
    padding: 0.5rem;
    background: #111;
    border-radius: 4px;
}
.workout-exercise .exercise-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: #ccc;
    margin-bottom: 0.35rem;
}
.workout-exercise .exercise-sets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}
.set-badge {
    font-size: 0.7rem;
    color: #888;
    background: #1a1a1a;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
}
.set-badge .set-type {
    color: var(--accent);
    font-size: 0.65rem;
    margin-left: 0.25rem;
}
.workout-empty {
    font-size: 0.8rem;
    color: #555;
    margin: 0;
}
</style>
{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="dash-header">
    <h1 data-i18n="dashboard.welcome_back" data-i18n-vars='{"username":"{{ username }}"}'>Welcome back, {{ username }}</h1>
    <p data-i18n="dashboard.performance_data">Your performance data from workouts, body weight, and active programs.</p>
</div>

<div class="dash-grid">
    <div class="dash-main">
        <div class="stat-cards">
            <div class="stat-card">
                <div class="stat-card-label" data-i18n="dashboard.stats.workout_streak">Workout streak</div>
                <div class="stat-card-value">{{ workoutStreak }}<small>{{ workoutStreak == 1 ? 'day' : 'days' }}</small></div>
                <div class="stat-card-hint">{{ totalWorkouts }} {{ totalWorkouts == 1 ? 'workout logged' : 'workouts logged' }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label" data-i18n="dashboard.stats.latest_workout">Latest workout</div>
                <div class="stat-card-value">{{ latestWorkoutLabel }}</div>
                <div class="stat-card-hint">{{ latestWorkoutBadge }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label" data-i18n="dashboard.stats.body_weight">Body weight</div>
                <div class="stat-card-value">{{ latestWeight }}</div>
                <div class="stat-card-hint">{{ weightHint }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label" data-i18n="dashboard.stats.avg_session">Avg session</div>
                <div class="stat-card-value">{{ averageSessionMinutes }}<small>min</small></div>
                <div class="stat-card-hint">{{ programCount }} {{ programCount == 1 ? 'active program' : 'active programs' }}</div>
            </div>
        </div>

        <div class="panel-row">
            <div class="panel-box">
                <h3 data-i18n="dashboard.progress_checklist.title"><i class="bi bi-list-check"></i> Progress checklist</h3>
                <div class="stat-inline">
                    <span class="stat-inline-label" data-i18n="dashboard.progress_checklist.workout_consistency">Workout consistency</span>
                    <span class="stat-inline-value {{ workoutStreak > 0 ? 'active' : '' }}">{{ workoutStreak > 0 ? 'On track' : 'Start now' }}</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-inline-label" data-i18n="dashboard.progress_checklist.programs_active">Programs active</span>
                    <span class="stat-inline-value active">{{ programCount }}</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-inline-label" data-i18n="dashboard.progress_checklist.weight_log">Weight log</span>
                    <span class="stat-inline-value {{ latestWeight != 'No weight recorded' ? 'active' : '' }}">{{ latestWeight != 'No weight recorded' ? 'Up to date' : 'Add entry' }}</span>
                </div>
            </div>
            <div class="panel-box">
                <h3 data-i18n="dashboard.recommended_supplements.title"><i class="bi bi-capsule"></i> Recommended supplements</h3>
                <div class="supplement-grid">
                    {% for item in recommendedSupplements %}
                    <div class="supplement-item">
                        <div>
                            <div class="supplement-name">{{ item.name }}</div>
                            <div class="supplement-benefit">{{ item.benefit }}</div>
                        </div>
                        <span class="supplement-tag">{{ item.tag }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="panel-box mt-4">
            <h3><i class="bi bi-clock-history"></i> Past Workouts</h3>
            {% if recentWorkouts %}
            <div class="workout-history">
                {% for workout in recentWorkouts %}
                <div class="workout-card">
                    <div class="workout-header">
                        <div>
                            <span class="workout-date">{{ workout.session_date }}</span>
                            <span class="workout-time">{{ workout.start_time ? workout.start_time|date('g:i A') : '' }}</span>
                        </div>
                        <span class="workout-duration">{{ workout.total_duration ? (workout.total_duration / 60)|round ~ ' min' : '--' }}</span>
                    </div>
                    {% if workout.exercises %}
                    <div class="workout-exercises">
                        {% for exercise in workout.exercises %}
                        <div class="workout-exercise">
                            <div class="exercise-name">{{ exercise.exercise_name }}</div>
                            <div class="exercise-sets">
                                {% for set in exercise.sets %}
                                <span class="set-badge">
                                    {{ set.reps }} reps × {{ set.weight }} lbs
                                    {% if set.set_type != 'normal' %}<span class="set-type">({{ set.set_type }})</span>{% endif %}
                                </span>
                                {% endfor %}
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <p class="workout-empty">No exercises logged</p>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
            {% else %}
            <p class="text-muted mb-0">No workout history yet. Start a workout to see your progress here.</p>
            {% endif %}
        </div>
    </div>

    <div class="dash-sidebar">
        <div class="panel-box">
            <h3 data-i18n="dashboard.latest_articles.title"><i class="bi bi-newspaper"></i> Latest articles</h3>
            <div class="article-list">
                {% for article in latestArticles %}
                <div class="article-item">
                    <div>
                        <div class="article-item-title">{{ article.title }}</div>
                        <div class="article-item-desc">{{ article.summary }}</div>
                    </div>
                    <a href="{{ article.url }}" target="_blank" class="badge-read" data-i18n="dashboard.latest_articles.read">Read</a>
                </div>
                {% endfor %}
            </div>
            <a href="/EcomProject/public/analytics" class="btn-gainz mt-3 w-100 text-center" data-i18n="dashboard.latest_articles.see_more_insights">See more insights</a>
        </div>

        <div class="panel-box">
            <h3 data-i18n="dashboard.todays_focus.title"><i class="bi bi-lightning-charge-fill"></i> Today's focus</h3>
            <div class="action-item">
                <div class="action-label" data-i18n="dashboard.todays_focus.complete_today">Complete today</div>
                <div class="action-value">{{ totalWorkouts > 0 ? 'Keep going' : 'Start logging' }}</div>
                <div class="action-note" data-i18n="dashboard.todays_focus.log_workout_note">Log a workout or weight to power your dashboard</div>
            </div>
            <div class="action-item">
                <div class="action-label" data-i18n="dashboard.todays_focus.weekly_goal">Weekly goal</div>
                <div class="action-value">{{ programCount > 0 ? 'Stay consistent' : 'Pick a program' }}</div>
                <div class="action-note" data-i18n="dashboard.todays_focus.follow_plan_note">Follow your plan and update progress daily</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}