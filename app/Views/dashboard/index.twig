{% extends "layout/base.twig" %}

{% block title %}Dashboard — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title">Welcome back, {{ username }}!</h1>
    <p class="section-subtitle">Select a module to begin your session</p>
    <div class="section-title-bar"></div>
</div>

<div class="row g-4">
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card">
            <i class="bi bi-activity dash-card-icon"></i>
            <h6 class="dash-card-title">Workout Sessions</h6>
            <p class="dash-card-desc">Log and track your sessions</p>
            <a href="/EcomProject/public/workouts" class="dash-card-btn">
                Enter <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card">
            <i class="bi bi-journal-text dash-card-icon"></i>
            <h6 class="dash-card-title">Training Programs</h6>
            <p class="dash-card-desc">Browse and manage programs</p>
            <a href="/EcomProject/public/programs" class="dash-card-btn">
                Enter <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card">
            <i class="bi bi-graph-up dash-card-icon"></i>
            <h6 class="dash-card-title">Analytics</h6>
            <p class="dash-card-desc">View your progress over time</p>
            <a href="/EcomProject/public/analytics" class="dash-card-btn">
                Enter <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-card">
            <i class="bi bi-speedometer2 dash-card-icon"></i>
            <h6 class="dash-card-title">Body Weight</h6>
            <p class="dash-card-desc">Track your weight over time</p>
            <a href="/EcomProject/public/body-weight" class="dash-card-btn">
                Enter <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>
{% endblock %}