{% extends "layout/base.twig" %}

{% block title %}Dashboard — GAINZ{% endblock %}

{% block head %}
<style>
.dash-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 1.5rem;
}
@media (max-width: 992px) {
    .dash-grid { grid-template-columns: 1fr; }
}
.dash-header {
    margin-bottom: 2rem;
}
.dash-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
}
.dash-header p {
    color: #777;
    font-size: 0.95rem;
}
.stat-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 768px) {
    .stat-cards { grid-template-columns: repeat(2, 1fr); }
}
.stat-card {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    padding: 1.25rem;
    border-radius: 0.5rem;
}
.stat-card-label {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
}
.stat-card-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent);
}
.stat-card-value small {
    font-size: 0.8rem;
    font-weight: 400;
    color: #666;
}
.stat-card-hint {
    font-size: 0.75rem;
    color: #555;
    margin-top: 0.5rem;
}
.panel-box {
    background: var(--panel-bg);
    border: 1px solid var(--border);
    padding: 1.5rem;
    border-radius: 0.5rem;
    margin-bottom: 1.5rem;
}
.panel-box h3 {
    font-size: 0.8rem;
    letter-spacing: 1px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1a1a1a;
}
.panel-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 576px) {
    .panel-row { grid-template-columns: 1fr; }
}
.stat-inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid #161616;
}
.stat-inline:last-child { border-bottom: none; }
.stat-inline-label {
    font-size: 0.72rem;
    letter-spacing: 1px;
    color: #666;
    text-transform: uppercase;
}
.stat-inline-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
}
.stat-inline-value.active { color: var(--accent); }
.article-list { display: flex; flex-direction: column; gap: 0.75rem; }
.article-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(255,255,255,0.02);
    border-radius: 0.35rem;
    border: 1px solid #161616;
}
.article-item-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddd;
    margin-bottom: 0.25rem;
}
.article-item-desc {
    font-size: 0.72rem;
    color: #666;
}
.badge-read {
    font-size: 0.6rem;
    background: rgba(200,255,0,0.1);
    color: var(--accent);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
    flex-shrink: 0;
}
.action-item {
    padding: 1rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid #161616;
    border-radius: 0.45rem;
    margin-bottom: 0.75rem;
}
.action-item:last-child { margin-bottom: 0; }
.action-label {
    font-size: 0.65rem;
    letter-spacing: 1.5px;
    color: #666;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
}
.action-value {
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
}
.action-note {
    font-size: 0.72rem;
    color: #666;
    margin-top: 0.35rem;
}
.supplement-grid {
    display: grid;
    gap: 0.75rem;
}
.supplement-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: rgba(255,255,255,0.02);
    border-radius: 0.35rem;
}
.supplement-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #ddd;
}
.supplement-benefit {
    font-size: 0.7rem;
    color: #666;
    margin-top: 0.15rem;
}
.supplement-tag {
    font-size: 0.55rem;
    background: rgba(200,255,0,0.1);
    color: var(--accent);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
}
</style>
{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="dash-header">
    <h1>Welcome back, {{ username }}</h1>
    <p>Your performance data from workouts, body weight, and active programs.</p>
</div>

<div class="dash-grid">
    <div class="dash-main">
        <div class="stat-cards">
            <div class="stat-card">
                <div class="stat-card-label">Workout streak</div>
                <div class="stat-card-value">{{ workoutStreak }}<small>day{{ workoutStreak == 1 ? '' : 's' }}</small></div>
                <div class="stat-card-hint">{{ totalWorkouts }} workout{{ totalWorkouts == 1 ? '' : 's' }} logged</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Latest workout</div>
                <div class="stat-card-value">{{ latestWorkoutLabel }}</div>
                <div class="stat-card-hint">{{ latestWorkoutBadge }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Body weight</div>
                <div class="stat-card-value">{{ latestWeight }}</div>
                <div class="stat-card-hint">{{ weightHint }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Avg session</div>
                <div class="stat-card-value">{{ averageSessionMinutes }}<small>min</small></div>
                <div class="stat-card-hint">{{ programCount }} active program{{ programCount == 1 ? '' : 's' }}</div>
            </div>
        </div>

        <div class="panel-row">
            <div class="panel-box">
                <h3><i class="bi bi-list-check"></i> Progress checklist</h3>
                <div class="stat-inline">
                    <span class="stat-inline-label">Workout consistency</span>
                    <span class="stat-inline-value {{ workoutStreak > 0 ? 'active' : '' }}">{{ workoutStreak > 0 ? 'On track' : 'Start now' }}</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-inline-label">Programs active</span>
                    <span class="stat-inline-value active">{{ programCount }}</span>
                </div>
                <div class="stat-inline">
                    <span class="stat-inline-label">Weight log</span>
                    <span class="stat-inline-value {{ latestWeight != 'No weight recorded' ? 'active' : '' }}">{{ latestWeight != 'No weight recorded' ? 'Up to date' : 'Add entry' }}</span>
                </div>
            </div>
            <div class="panel-box">
                <h3><i class="bi bi-capsule"></i> Recommended supplements</h3>
                <div class="supplement-grid">
                    {% for item in recommendedSupplements %}
                    <div class="supplement-item">
                        <div>
                            <div class="supplement-name">{{ item.name }}</div>
                            <div class="supplement-benefit">{{ item.benefit }}</div>
                        </div>
                        <span class="supplement-tag">{{ item.tag }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <div class="dash-sidebar">
        <div class="panel-box">
            <h3><i class="bi bi-newspaper"></i> Latest articles</h3>
            <div class="article-list">
                {% for article in latestArticles %}
                <div class="article-item">
                    <div>
                        <div class="article-item-title">{{ article.title }}</div>
                        <div class="article-item-desc">{{ article.summary }}</div>
                    </div>
                    <a href="{{ article.url }}" target="_blank" class="badge-read">Read</a>
                </div>
                {% endfor %}
            </div>
            <a href="/EcomProject/public/analytics" class="btn-gainz mt-3 w-100 text-center">See more insights</a>
        </div>

        <div class="panel-box">
            <h3><i class="bi bi-lightning-charge-fill"></i> Today's focus</h3>
            <div class="action-item">
                <div class="action-label">Complete today</div>
                <div class="action-value">{{ totalWorkouts > 0 ? 'Keep going' : 'Start logging' }}</div>
                <div class="action-note">Log a workout or weight to power your dashboard</div>
            </div>
            <div class="action-item">
                <div class="action-label">Weekly goal</div>
                <div class="action-value">{{ programCount > 0 ? 'Stay consistent' : 'Pick a program' }}</div>
                <div class="action-note">Follow your plan and update progress daily</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}