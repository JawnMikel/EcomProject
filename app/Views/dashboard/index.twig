{% extends "layout/base.twig" %}

{% block title %}Dashboard — GAINZ{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Welcome back, {{ username }}!</h1>
</div>

<div class="row g-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-activity fs-1 text-dark"></i>
                <h6 class="card-title mt-2">Workout Sessions</h6>
                <p class="text-muted small">Log and track your sessions</p>
                <a href="#" class="btn btn-sm btn-dark">Go</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-journal-text fs-1 text-dark"></i>
                <h6 class="card-title mt-2">Training Programs</h6>
                <p class="text-muted small">Browse and manage programs</p>
                <a href="#" class="btn btn-sm btn-dark">Go</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-graph-up fs-1 text-dark"></i>
                <h6 class="card-title mt-2">Analytics</h6>
                <p class="text-muted small">View your progress over time</p>
                <a href="#" class="btn btn-sm btn-dark">Go</a>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
            <div class="card-body">
                <i class="bi bi-speedometer2 fs-1 text-dark"></i>
                <h6 class="card-title mt-2">Body Weight</h6>
                <p class="text-muted small">Track your weight over time</p>
                <a href="#" class="btn btn-sm btn-dark">Go</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
