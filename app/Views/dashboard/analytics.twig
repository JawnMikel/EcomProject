{% extends "layout/base.twig" %}

{% block title %}Analytics — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title">Analytics</h1>
    <p class="section-subtitle">Review your training trends and progress.</p>
    <div class="section-title-bar"></div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Workouts</div>
            <div class="stat-value accent">{{ stats.total_workouts }}</div>
            <div class="stat-desc">Total sessions logged</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Total Duration</div>
            <div class="stat-value">{{ (stats.total_duration_seconds / 60) | round(0) }} min</div>
            <div class="stat-desc">Across all sessions</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Avg Volume</div>
            <div class="stat-value">{{ stats.average_volume | round(1) }} lbs</div>
            <div class="stat-desc">Average logged volume</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Programs</div>
            <div class="stat-value">{{ programCount }}</div>
            <div class="stat-desc">Programs created</div>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-lg-8">
        <div class="panel-card">
            <h5 class="panel-card-title">
                <i class="bi bi-graph-up"></i> Weight Trend
            </h5>
            {% if weightTrend %}
            <table class="gainz-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Weight</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in weightTrend %}
                    <tr>
                        <td>{{ row.entry_date }}</td>
                        <td>{{ row.weight_value }} kg</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% else %}
            <p class="text-muted mb-0">Add weight entries to see your trend here.</p>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel-card h-100">
            <h5 class="panel-card-title">
                <i class="bi bi-speedometer2"></i> Current Weight
            </h5>
            <div class="stat-value" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                {{ lastWeight ? lastWeight ~ ' kg' : 'N/A' }}
            </div>
            <p class="text-muted mb-0">Most recent recorded body weight.</p>
        </div>
    </div>
</div>
{% endblock %}