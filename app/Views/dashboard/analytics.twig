{% extends "layout/base.twig" %}

{% block title %}Analytics — GAINZ{% endblock %}

{% block content %}
<div class="watermark"><i class="bi bi-lightning-charge-fill"></i></div>

<div class="section-header">
    <h1 class="section-title" data-i18n="analytics.title">Analytics</h1>
    <p class="section-subtitle" data-i18n="analytics.subtitle">Review your training trends and progress.</p>
    <div class="section-title-bar"></div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Workouts</div>
            <div class="stat-value accent">{{ stats.total_workouts }}</div>
            <div class="stat-desc">Total sessions logged</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Total Duration</div>
            <div class="stat-value">{{ (stats.total_duration_seconds / 60) | round(0) }} min</div>
            <div class="stat-desc">Across all sessions</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Avg Volume</div>
            <div class="stat-value">{{ stats.average_volume | round(1) }} lbs</div>
            <div class="stat-desc">Average logged volume</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-label">Programs</div>
            <div class="stat-value">{{ programCount }}</div>
            <div class="stat-desc">Programs created</div>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-lg-8">
        <div class="panel-card">
            <h5 class="panel-card-title">
                <i class="bi bi-graph-up"></i> Weight Trend
            </h5>
            {% if weightTrend %}
            <div style="height: 300px; position: relative;">
                <canvas id="weightChart"></canvas>
            </div>
            {% else %}
            <p class="text-muted mb-0">Add weight entries to see your trend here.</p>
            {% endif %}
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel-card h-100">
            <h5 class="panel-card-title">
                <i class="bi bi-speedometer2"></i> Current Weight
            </h5>
            <div class="stat-value" style="font-size: 2.5rem; margin-bottom: 0.5rem;">
                {{ lastWeight ? lastWeight ~ ' lbs' : 'N/A' }}
            </div>
            <p class="text-muted mb-0">Most recent recorded body weight.</p>
        </div>
    </div>
</div>

{% if weightTrend %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('weightChart').getContext('2d');
    const weightData = {{ weightTrend|json_encode|raw }};

    // Reverse to show oldest to newest (left to right)
    const reversedData = [...weightData].reverse();

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: reversedData.map(row => row.entry_date),
            datasets: [{
                label: 'Weight (lbs)',
                data: reversedData.map(row => row.weight_value),
                borderColor: '#cfff00',
                backgroundColor: 'rgba(207, 255, 0, 0.1)',
                fill: true,
                tension: 0.3,
                pointBackgroundColor: '#cfff00',
                pointBorderColor: '#111',
                pointBorderWidth: 2,
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: '#222',
                    titleColor: '#fff',
                    bodyColor: '#cfff00',
                    borderColor: '#444',
                    borderWidth: 1,
                    displayColors: false,
                    callbacks: {
                        label: function(context) {
                            return context.parsed.y + ' lbs';
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        color: '#333'
                    },
                    ticks: {
                        color: '#888'
                    }
                },
                y: {
                    grid: {
                        color: '#333'
                    },
                    ticks: {
                        color: '#888',
                        callback: function(value) {
                            return value + ' lbs';
                        }
                    }
                }
            }
        }
    });
});
</script>
{% endif %}
{% endblock %}