{% extends "layout/base.twig" %}

{% block title %}Analytics — GAINZ{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold">Analytics</h1>
        <p class="text-muted">Review your training trends and progress.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-uppercase text-muted mb-2">Workouts</h6>
            <h2 class="fw-bold mb-0">{{ stats.total_workouts }}</h2>
            <p class="text-muted small mb-0">Total sessions logged</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-uppercase text-muted mb-2">Total Duration</h6>
            <h2 class="fw-bold mb-0">{{ (stats.total_duration_seconds / 60) | round(0) }} min</h2>
            <p class="text-muted small mb-0">Across all sessions</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-uppercase text-muted mb-2">Avg Volume</h6>
            <h2 class="fw-bold mb-0">{{ stats.average_volume | round(1) }} kg</h2>
            <p class="text-muted small mb-0">Average logged volume</p>
        </div>
    </div>
    <div class="col-md-6 col-xl-3">
        <div class="card shadow-sm p-3">
            <h6 class="text-uppercase text-muted mb-2">Programs</h6>
            <h2 class="fw-bold mb-0">{{ programCount }}</h2>
            <p class="text-muted small mb-0">Programs created</p>
        </div>
    </div>
</div>

<div class="row g-4 mt-3">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Weight Trend</h5>
                {% if weightTrend %}
                <div class="table-responsive">
                    <table class="table table-sm table-borderless">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in weightTrend %}
                            <tr>
                                <td>{{ row.entry_date }}</td>
                                <td>{{ row.weight_value }} kg</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <p class="text-muted mb-0">Add weight entries to see your trend here.</p>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Current Weight</h5>
                <p class="display-6 fw-bold mb-1">{{ lastWeight ? lastWeight ~ ' kg' : 'N/A' }}</p>
                <p class="text-muted">Most recent recorded body weight.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
