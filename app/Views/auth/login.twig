<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login — GAINZ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --accent:     #c8ff00;
            --accent-dim: rgba(200, 255, 0, 0.12);
            --bg:         #080808;
            --panel-bg:   #111111;
            --border:     #272727;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html { font-size: 16px; }

        body {
            background: var(--bg);
            color: #fff;
            font-family: 'Barlow Condensed', 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            text-rendering: optimizeLegibility;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* ── Watermark ── */
        .watermark {
            position: fixed;
            bottom: -10px;
            right: -20px;
            font-size: 260px;
            color: #fff;
            opacity: 0.025;
            pointer-events: none;
            line-height: 1;
            transform: rotate(-8deg);
            z-index: 0;
            font-family: 'bootstrap-icons';
        }

        /* ── Main wrapper ── */
        .auth-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
            position: relative;
            z-index: 1;
        }

        .auth-panel {
            width: 100%;
            max-width: 420px;
        }

        /* ── Brand ── */
        .brand-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-bottom: 0.4rem;
        }

        .brand-logo .logo-icon {
            color: var(--accent);
            font-size: 1.6rem;
            filter: drop-shadow(0 0 6px rgba(200, 255, 0, 0.6));
        }

        .brand-name {
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: 6px;
            color: #fff;
            text-transform: uppercase;
        }

        .brand-sub {
            text-align: center;
            font-size: 0.68rem;
            letter-spacing: 4px;
            color: #4a4a4a;
            text-transform: uppercase;
            margin-bottom: 2.5rem;
        }

        /* ── Card ── */
        .auth-card {
            background: var(--panel-bg);
            border: 1px solid var(--border);
            border-left: 3px solid var(--accent);
            padding: 2.25rem 2.25rem 1.75rem;
            box-shadow:
                0 0 0 1px rgba(200, 255, 0, 0.04),
                0 20px 60px rgba(0, 0, 0, 0.6),
                -4px 0 20px rgba(200, 255, 0, 0.06);
        }

        .auth-title {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: 5px;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 0.5rem;
        }

        .auth-title-bar {
            width: 40px;
            height: 2px;
            background: var(--accent);
            box-shadow: 0 0 8px rgba(200, 255, 0, 0.5);
            margin-bottom: 2rem;
        }

        /* ── Fields ── */
        .field-label {
            display: block;
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #666;
            margin-bottom: 0.5rem;
        }

        .field-wrap {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .auth-input {
            width: 100%;
            background: #0a0a0a;
            border: 1px solid #2a2a2a;
            border-radius: 2px;
            color: #e8e8e8;
            font-family: 'Share Tech Mono', 'Courier New', monospace;
            font-size: 0.82rem;
            letter-spacing: 0.5px;
            padding: 0.75rem 2.75rem 0.75rem 1rem;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            -webkit-font-smoothing: antialiased;
        }

        .auth-input:focus {
            outline: none;
            border-color: var(--accent);
            background: #0c0c0c;
            color: #fff;
            box-shadow:
                0 0 0 3px rgba(200, 255, 0, 0.07),
                inset 0 1px 3px rgba(0, 0, 0, 0.4);
        }

        .auth-input::placeholder {
            color: #303030;
            font-size: 0.78rem;
            letter-spacing: 0.5px;
        }

        .field-icon {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            color: #3a3a3a;
            font-size: 0.9rem;
            pointer-events: none;
            transition: color 0.2s;
        }

        .auth-input:focus ~ .field-icon {
            color: #666;
        }

        .field-icon.clickable {
            pointer-events: all;
            cursor: pointer;
        }

        .field-icon.clickable:hover {
            color: #888;
        }

        /* ── Button ── */
        .btn-access {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            width: 100%;
            background: var(--accent);
            color: #000;
            border: none;
            border-radius: 2px;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 0.88rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            padding: 0.85rem 1rem;
            margin-top: 1.75rem;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(200, 255, 0, 0.2);
            transition: background 0.15s, box-shadow 0.15s, transform 0.1s;
        }

        .btn-access:hover {
            background: #d6ff1f;
            box-shadow: 0 0 30px rgba(200, 255, 0, 0.4);
            transform: translateY(-1px);
        }

        .btn-access:active {
            transform: translateY(0);
            box-shadow: 0 0 10px rgba(200, 255, 0, 0.2);
        }

        /* ── Links ── */
        .auth-links {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.1rem;
        }

        .auth-link {
            display: flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #484848;
            text-decoration: none;
            padding: 0.35rem 0;
            transition: color 0.2s;
        }

        .auth-link:hover {
            color: var(--accent);
        }

        /* ── Card footer ── */
        .auth-card-footer {
            border-top: 1px solid #1c1c1c;
            margin-top: 1.75rem;
            padding-top: 1rem;
            display: flex;
            justify-content: space-between;
        }

        .auth-card-footer span {
            font-size: 0.62rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #2e2e2e;
        }

        /* ── Error alert ── */
        .auth-error {
            background: rgba(255, 60, 60, 0.07);
            border: 1px solid rgba(255, 60, 60, 0.2);
            border-left: 3px solid #ff4444;
            color: #ff7070;
            font-size: 0.72rem;
            letter-spacing: 1px;
            padding: 0.65rem 1rem;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
        }

        /* ── Footer ── */
        .site-footer {
            background: #000;
            border-top: 1px solid #161616;
            padding: 0.8rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 0.5rem;
            position: relative;
            z-index: 1;
        }

        .footer-brand {
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: var(--accent);
            text-transform: uppercase;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .footer-links a {
            font-size: 0.62rem;
            letter-spacing: 1px;
            color: #333;
            text-decoration: none;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .footer-links a:hover { color: #666; }

        .footer-copy {
            font-size: 0.62rem;
            letter-spacing: 1px;
            color: #252525;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

<div class="watermark"><i class="bi bi-person-running"></i></div>

<div class="auth-wrapper">
    <div class="auth-panel">

        <div class="brand-logo">
            <i class="bi bi-lightning-charge-fill logo-icon"></i>
            <span class="brand-name">Gainz</span>
        </div>
        <p class="brand-sub">Industrial Athletics System</p>

        <div class="auth-card">
            <div class="auth-title">LOGIN</div>
            <div class="auth-title-bar"></div>

            {% if error %}
            <div class="auth-error">
                <i class="bi bi-exclamation-triangle me-1"></i>{{ error }}
            </div>
            {% endif %}

            <form method="POST" action="/EcomProject/public/login">

                <div>
                    <label class="field-label" for="email">EMAIL OR USERNAME</label>
                    <div class="field-wrap">
                        <input type="text"
                               id="email"
                               name="email"
                               class="auth-input"
                               placeholder="Email or Username"
                               required
                               autofocus>
                        <i class="bi bi-person field-icon"></i>
                    </div>
                </div>

                <div>
                    <label class="field-label" for="password">PASSWORD</label>
                    <div class="field-wrap">
                        <input type="password"
                               id="password"
                               name="password"
                               class="auth-input"
                               placeholder="••••••••••••"
                               required>
                        <i class="bi bi-eye field-icon clickable"
                           id="pwd-toggle"
                           onclick="togglePassword()"></i>
                    </div>
                </div>

                <button type="submit" class="btn-access">
                    LOGIN <i class="bi bi-lightning-charge-fill"></i>
                </button>

            </form>

            <div class="auth-links">
                <a href="/EcomProject/public/register" class="auth-link">
                    <i class="bi bi-chevron-right"></i> New Recruit? Create Account
                </a>
                <a href="#" class="auth-link">
                    <i class="bi bi-arrow-repeat"></i> Reset Access
                </a>
            </div>

            <div class="auth-card-footer">
                <span>GAINZ Athletic, v2.0</span>
                <span>Portal 1/1</span>
            </div>
        </div>

    </div>
</div>

<footer class="site-footer">
    <span class="footer-brand">GAINZ Industrial Athletics. No Weakness.</span>
    <div class="footer-links">
        <a href="#">Terms of Service</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Support</a>
        <a href="#">API</a>
    </div>
    <span class="footer-copy">© 2025 GAINZ Industrial Athletics.</span>
</footer>

<script>
function togglePassword() {
    const input = document.getElementById('password');
    const icon  = document.getElementById('pwd-toggle');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash field-icon clickable';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye field-icon clickable';
    }
}
</script>
</body>
</html>
