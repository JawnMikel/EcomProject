# GAINZ Application Environment Configuration

# Application
APP_NAME="GAINZ Fitness Tracker"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database - UPDATE THESE WITH YOUR MYSQL CREDENTIALS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gainz
DB_USER=root
DB_PASSWORD=

# JWT Configuration - CHANGE THIS TO A RANDOM SECRET KEY
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Email Configuration (for 2FA - optional)
MAIL_FROM=noreply@gainz.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Supported Languages
SUPPORTED_LANGUAGES=en,fr
DEFAULT_LANGUAGE=en

# Application Settings
MIN_USER_AGE=16