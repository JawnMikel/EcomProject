APP_NAME=GAINZ
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gainz
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Email Configuration (for 2FA)
EMAIL_FROM=noreply@gainz-app.local
EMAIL_FROM_NAME="GAINZ System"
# Use a local SMTP test tool such as smtp4dev listening on 127.0.0.1:25
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=25
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_ENCRYPTION=

SUPPORTED_LANGUAGES=en,fr
DEFAULT_LANGUAGE=en
MIN_USER_AGE=16
