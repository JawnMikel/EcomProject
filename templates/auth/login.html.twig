{% extends "base.html.twig" %}

{% block title %}{{ i18n.trans('auth.login') }}{% endblock %}

{% block content %}
<div class="flex flex-center mt-4">
    <div class="card" style="max-width: 400px; width: 100%;">
        <div class="card-header text-center">{{ i18n.trans('auth.login') }}</div>

        <form method="POST" action="{{ path('login') }}">
            <div class="form-group">
                <label for="email">{{ i18n.trans('auth.email') }}</label>
                <input type="email" id="email" name="email" class="form-control" required placeholder="your@email.com">
            </div>

            <div class="form-group">
                <label for="password">{{ i18n.trans('auth.password') }}</label>
                <input type="password" id="password" name="password" class="form-control" required>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;">
                {{ i18n.trans('auth.login') }}
            </button>
        </form>

        <p class="text-center mt-3">
            {{ i18n.trans('auth.no_account') }}
            <a href="{{ path('register') }}">{{ i18n.trans('auth.register') }}</a>
        </p>
    </div>
</div>
{% endblock %}