{% extends "base.html.twig" %}

{% block title %}{{ i18n.trans('workout.session') }}{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>{{ i18n.trans('workout.session') }}</h1>
        <p class="subtitle">{{ session.getStartDate() }} - {{ session.getStartTime() }}</p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">{{ i18n.trans('workout.add_set') }}</div>
    
    <form method="POST" action="{{ path('workouts.add_set', {id: session.id}) }}" class="grid grid-4 gap-2">
        <div class="form-group">
            <label>{{ i18n.trans('exercises.name') }}</label>
            <select name="exercise_id" class="form-control" required>
                <option value="">{{ i18n.trans('exercises.select') }}</option>
                <!-- Exercises would be populated here -->
            </select>
        </div>
        
        <div class="form-group">
            <label>{{ i18n.trans('workout.sets') }}</label>
            <input type="number" name="set_number" class="form-control" min="1" value="1" required>
        </div>
        
        <div class="form-group">
            <label>{{ i18n.trans('workout.reps') }}</label>
            <input type="number" name="reps" class="form-control" min="1" required>
        </div>
        
        <div class="form-group">
            <label>{{ i18n.trans('workout.weight') }} (kg)</label>
            <input type="number" name="weight" class="form-control" min="0" step="0.5" value="0">
        </div>
        
        <div class="form-group" style="align-self: end;">
            <button type="submit" class="btn btn-primary">{{ i18n.trans('workout.add_set') }}</button>
        </div>
    </form>
</div>

{% if items is not empty %}
<div class="card mb-4">
    <div class="card-header">{{ i18n.trans('workout.exercises') }}</div>
    
    <table class="table">
        <thead>
            <tr>
                <th>{{ i18n.trans('workout.exercise') }}</th>
                <th>{{ i18n.trans('workout.sets') }}</th>
                <th>{{ i18n.trans('workout.reps') }}</th>
                <th>{{ i18n.trans('workout.weight') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
            <tr>
                <td>Exercise #{{ item.exerciseId }}</td>
                <td>{{ item.setNumber }}</td>
                <td>{{ item.reps }}</td>
                <td>{{ item.getFormattedWeight() }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<div class="card">
    <div class="card-header">{{ i18n.trans('workout.end_session') }}</div>
    
    <form method="POST" action="{{ path('workouts.end', {id: session.id}) }}">
        <div class="form-group">
            <label>{{ i18n.trans('workout.duration') }} (seconds)</label>
            <input type="number" name="duration" class="form-control" min="1" required>
        </div>
        
        <div class="form-group">
            <label>{{ i18n.trans('workout.notes') }}</label>
            <textarea name="notes" class="form-control" rows="3"></textarea>
        </div>
        
        <button type="submit" class="btn btn-success">
            {{ i18n.trans('workout.end_session') }}
        </button>
    </form>
</div>
{% endblock %}