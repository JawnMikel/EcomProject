{% extends "base.html.twig" %}

{% block title %}{{ i18n.trans('bodyweight.title') }}{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>{{ i18n.trans('bodyweight.title') }}</h1>
    </div>
</div>

{% if currentWeight %}
<div class="grid grid-3 mb-4">
    <div class="stat-card">
        <div class="stat-value">{{ currentWeight.getFormattedWeight() }}</div>
        <div class="stat-label">{{ i18n.trans('bodyweight.current_weight') }}</div>
    </div>
</div>
{% endif %}

<div class="grid grid-2">
    <div class="card">
        <div class="card-header">{{ i18n.trans('bodyweight.add_entry') }}</div>
        
        <form method="POST" action="{{ path('bodyweight.store') }}">
            <div class="form-group">
                <label>{{ i18n.trans('bodyweight.weight') }}</label>
                <input type="number" name="weight" class="form-control" step="0.1" required>
            </div>
            
            <div class="form-group">
                <label>{{ i18n.trans('bodyweight.unit') }}</label>
                <select name="unit" class="form-control">
                    <option value="kg">{{ i18n.trans('bodyweight.kg') }}</option>
                    <option value="lbs">{{ i18n.trans('bodyweight.lbs') }}</option>
                </select>
            </div>
            
            <button type="submit" class="btn btn-primary">{{ i18n.trans('bodyweight.add_entry') }}</button>
        </form>
    </div>

    <div class="card">
        <div class="card-header">{{ i18n.trans('bodyweight.history') }}</div>
        
        {% if entries is not empty %}
        <table class="table">
            <thead>
                <tr>
                    <th>{{ i18n.trans('bodyweight.date') }}</th>
                    <th>{{ i18n.trans('bodyweight.weight') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for entry in entries %}
                <tr>
                    <td>{{ entry.getRecordedDate() }}</td>
                    <td>{{ entry.getFormattedWeight() }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p>{{ i18n.trans('bodyweight.no_entries') }}</p>
        {% endif %}
    </div>
</div>
{% endblock %}