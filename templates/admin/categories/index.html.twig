{% extends "base.html.twig" %}

{% block title %}{{ i18n.trans('admin.categories') }}{% endblock %}

{% block content %}
<div class="page-header">
    <div>
        <h1>{{ i18n.trans('admin.categories') }}</h1>
    </div>
    <button class="btn btn-primary" onclick="document.getElementById('addModal').style.display='block'">
        {{ i18n.trans('admin.add_category') }}
    </button>
</div>

<div class="card">
    <table class="table">
        <thead>
            <tr>
                <th>{{ i18n.trans('categories.name') }} (EN)</th>
                <th>{{ i18n.trans('categories.name') }} (FR)</th>
                <th>{{ i18n.trans('general.actions') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for category in categories %}
            <tr>
                <td>{{ category.nameEn }}</td>
                <td>{{ category.nameFr }}</td>
                <td>
                    <form method="POST" action="{{ path('admin.categories.delete', {id: category.id}) }}" style="display: inline;" onsubmit="return confirm('{{ i18n.trans('admin.confirm_delete') }}')">
                        <button type="submit" class="btn btn-danger">{{ i18n.trans('admin.delete') }}</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<!-- Add Category Modal -->
<div id="addModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;">
    <div class="card" style="max-width: 500px; margin: 100px auto; position: relative;">
        <button onclick="document.getElementById('addModal').style.display='none'" style="position: absolute; top: 10px; right: 10px; background: none; border: none; font-size: 20px; cursor: pointer;">×</button>
        
        <div class="card-header">{{ i18n.trans('admin.add_category') }}</div>
        
        <form method="POST" action="{{ path('admin.categories.store') }}">
            <div class="form-group">
                <label>{{ i18n.trans('categories.name') }} (EN)</label>
                <input type="text" name="name_en" class="form-control" required>
            </div>
            
            <div class="form-group">
                <label>{{ i18n.trans('categories.name') }} (FR)</label>
                <input type="text" name="name_fr" class="form-control" required>
            </div>
            
            <button type="submit" class="btn btn-primary">{{ i18n.trans('admin.save') }}</button>
        </form>
    </div>
</div>
{% endblock %}